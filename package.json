{
  "name": "issue-tracker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "test": "vitest run --env-file=.env",
    "build": "tsc && npm install --prefix ./vite-project/frontend && npm run build --prefix ./vite-project/frontend",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.3"
  }
}
